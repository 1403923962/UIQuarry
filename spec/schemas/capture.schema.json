{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiquarry.dev/schema/capture-v1.json",
  "title": "UIQuarry captured component",
  "description": "Sanitized observation of a selected live DOM fragment; not an editable design source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "sourceUrl", "capturedAt", "selector", "html", "css", "scripts", "events", "viewport", "bounds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "createdAt": {"type": "string", "format": "date-time", "description": "Added by the private product after an explicit user import."},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "tags": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
    "sourceUrl": {"type": "string", "format": "uri", "maxLength": 2048},
    "capturedAt": {"type": "string", "format": "date-time"},
    "selector": {"type": "string", "maxLength": 2048},
    "html": {"type": "string", "maxLength": 2000000, "description": "Sanitized selected fragment; no scripts or inline event-handler attributes."},
    "css": {"type": "string", "maxLength": 1000000, "description": "Styles scoped to the captured fragment."},
    "scripts": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "source", "relation"],
        "properties": {
          "kind": {"enum": ["inline", "external", "module", "reference"]},
          "source": {"type": "string", "maxLength": 200000, "description": "Script source or URL. Empty by default; only present after explicit import."},
          "selector": {"type": "string", "maxLength": 2048},
          "event": {"type": "string", "maxLength": 128},
          "relation": {"type": "string", "maxLength": 512},
          "license": {"type": "string", "maxLength": 128}
        }
      }
    },
    "events": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "target", "atMs"],
        "properties": {
          "type": {"type": "string", "maxLength": 64},
          "target": {"type": "string", "maxLength": 2048},
          "atMs": {"type": "number", "minimum": 0},
          "state": {"type": "string", "maxLength": 128},
          "value": {"type": ["string", "number", "boolean", "null"], "description": "Non-sensitive sampled state only; never store password or form values."}
        }
      }
    },
    "animations": {
      "type": "array",
      "maxItems": 32,
      "description": "Bounded Web Animations API observations for the selected subtree. The offline CLI caps this property's serialized JSON at 262144 bytes. These are sampled timing and keyframe values, not JavaScript source or a replay guarantee.",
      "items": {"$ref": "#/$defs/animation"}
    },
    "viewport": {"$ref": "#/$defs/size"},
    "bounds": {"$ref": "#/$defs/rect"},
    "canvasBitmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dataUrl"],
      "description": "One frame read from the selected canvas drawing buffer. Dimensions are intrinsic pixels.",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "dataUrl": {
          "type": "string",
          "maxLength": 5000000,
          "pattern": "^data:image/png;base64,(?=.+$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "compositeBitmap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "dataUrl"],
      "description": "Optional compositor-rendered crop of the selected element's visible bounds. Unlike canvasBitmap, this captures the final on-screen result and can work when a WebGL drawing buffer has already been cleared.",
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "dataUrl": {
          "type": "string",
          "maxLength": 3000000,
          "pattern": "^data:image/jpeg;base64,(?=.+$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "canvasRecording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMs", "mimeType", "dataUrl"],
      "description": "Optional short recording of the selected canvas only. It is a visual playback, not the source shader, JavaScript, or a guarantee that the interaction can be recreated.",
      "properties": {
        "durationMs": {"type": "integer", "minimum": 1, "maximum": 6000},
        "mimeType": {"const": "video/webm"},
        "dataUrl": {
          "type": "string",
          "maxLength": 3000000,
          "pattern": "^data:video/webm;base64,(?=.+$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "screenshot": {
      "type": "string",
      "maxLength": 10000000,
      "pattern": "^data:image/(jpeg|png);base64,(?=.+$)(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
      "description": "Optional JPEG or PNG data URL containing a screenshot of the current visible viewport. It preserves canvas, video, and other pixels outside the selected DOM subtree; it is not a full-page stitched screenshot."
    },
    "notes": {"type": "string", "maxLength": 4000}
  },
  "$defs": {
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "kind", "playState", "playbackRate", "timelineType", "timing", "keyframes"],
      "properties": {
        "targetId": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {"enum": ["CSSAnimation", "CSSTransition", "Animation"]},
        "pseudoElement": {"type": "string", "maxLength": 32},
        "playState": {"enum": ["pending", "running", "paused", "finished"]},
        "currentTime": {"type": ["number", "null"]},
        "playbackRate": {"type": "number"},
        "timelineType": {"enum": ["document", "scroll", "other", "unknown"]},
        "timing": {"$ref": "#/$defs/animationTiming"},
        "keyframes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/keyframe"}}
      }
    },
    "animationTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delay", "duration", "endDelay", "iterations", "direction", "easing", "fill"],
      "properties": {
        "delay": {"type": "number"},
        "duration": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "auto"}]},
        "endDelay": {"type": "number"},
        "iterations": {"oneOf": [{"type": "number", "minimum": 0}, {"const": "infinite"}]},
        "direction": {"enum": ["normal", "reverse", "alternate", "alternate-reverse"]},
        "easing": {"type": "string", "maxLength": 128},
        "fill": {"enum": ["none", "forwards", "backwards", "both", "auto"]}
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["properties"],
      "properties": {
        "offset": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "easing": {"type": "string", "maxLength": 128},
        "composite": {"enum": ["auto", "replace", "add", "accumulate"]},
        "properties": {
          "type": "object",
          "maxProperties": 24,
          "propertyNames": {"pattern": "^(?!--)(?!content$)(?!behavior$)(?!-moz-binding$)-?[a-z][a-z0-9-]*$"},
          "additionalProperties": {
            "anyOf": [
              {"type": "string", "maxLength": 256, "not": {"pattern": "[uU][rR][lL]\\s*\\("}},
              {"type": "number"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}, "deviceScaleFactor": {"type": "number", "exclusiveMinimum": 0}}
    },
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}}
    }
  }
}
