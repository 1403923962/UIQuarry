{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uiquarry.dev/schema/capture-v1.json",
  "title": "UIQuarry captured component",
  "description": "Sanitized observation of a selected live DOM fragment; not an editable design source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "sourceUrl", "capturedAt", "selector", "html", "css", "scripts", "events", "viewport", "bounds"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "createdAt": {"type": "string", "format": "date-time", "description": "Added by the private product after an explicit user import."},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "tags": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}},
    "sourceUrl": {"type": "string", "format": "uri", "maxLength": 2048},
    "capturedAt": {"type": "string", "format": "date-time"},
    "selector": {"type": "string", "maxLength": 2048},
    "html": {"type": "string", "maxLength": 2000000, "description": "Sanitized selected fragment; no scripts or inline event-handler attributes."},
    "css": {"type": "string", "maxLength": 1000000, "description": "Styles scoped to the captured fragment."},
    "scripts": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "source", "relation"],
        "properties": {
          "kind": {"enum": ["inline", "external", "module", "reference"]},
          "source": {"type": "string", "maxLength": 200000, "description": "Script source or URL. Empty by default; only present after explicit import."},
          "selector": {"type": "string", "maxLength": 2048},
          "event": {"type": "string", "maxLength": 128},
          "relation": {"type": "string", "maxLength": 512},
          "license": {"type": "string", "maxLength": 128}
        }
      }
    },
    "events": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "target", "atMs"],
        "properties": {
          "type": {"type": "string", "maxLength": 64},
          "target": {"type": "string", "maxLength": 2048},
          "atMs": {"type": "number", "minimum": 0},
          "state": {"type": "string", "maxLength": 128},
          "value": {"type": ["string", "number", "boolean", "null"], "description": "Non-sensitive sampled state only; never store password or form values."}
        }
      }
    },
    "viewport": {"$ref": "#/$defs/size"},
    "bounds": {"$ref": "#/$defs/rect"},
    "screenshot": {"type": "string", "maxLength": 10000000, "description": "Optional data URL or package-relative path."},
    "notes": {"type": "string", "maxLength": 4000}
  },
  "$defs": {
    "size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": {"width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}, "deviceScaleFactor": {"type": "number", "exclusiveMinimum": 0}}
    },
    "rect": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number", "minimum": 0}, "height": {"type": "number", "minimum": 0}}
    }
  }
}
